# Pianificazione dell'audit MARS periodico: una volta a settimana.
# (Il mercoledi' mattina, per non sovrapporsi al monitoraggio
# citazioni del lunedi': prima si corregge, poi si misura.)
#
# Installazione:
#   sudo cp deploy/mars-audit.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mars-audit.timer
#
# Verifica:  systemctl list-timers mars-audit
# Esecuzione manuale di prova:  sudo systemctl start mars-audit

[Unit]
Description=Audit MARS settimanale

[Timer]
OnCalendar=Wed 06:30
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
