# Esempio nginx per l'assetto SEPARATO di MARS Beacon (P1, Fase 3):
# il bundle statico gui/ servito come sito, l'API (mars_api.py)
# dietro proxy. Due scenari:
#
# SCENARIO A (consigliato) — stessa origine via proxy: nessun CORS,
#   niente token obbligatorio (il cookie di sessione funziona),
#   download come link semplici. config.js resta con
#   MARS_API_BASE = "".
#
# SCENARIO B — origini diverse (statici su un host, API su un
#   altro): avviare mars_api.py con --cors https://gui.esempio.it,
#   valorizzare MARS_API_BASE in config.js con l'origine dell'API
#   e accedere dalla GUI col token API personale (il cookie
#   SameSite=Strict non viaggia tra origini; l'avanzamento usa il
#   polling e i download passano da fetch+blob, gia' gestiti dal
#   bundle).
#
# Nota white-label (P2): il bundle statico gui/ e' il pacchetto da
# brandizzare — token in gui/brand/lympha-brand.css, logo e
# favicon in gui/brand/, ragione sociale nel footer.
#
# Il server API resta su 127.0.0.1 (mai esposto direttamente):
#   python3 mars_api.py --port 8766
# o la unit systemd equivalente (hardening come mars-gui.service).

server {
    listen 443 ssl http2;
    server_name mars.esempio.it;

    # ssl_certificate     /etc/letsencrypt/live/.../fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/.../privkey.pem;

    # Bundle statico della GUI (una copia di gui/, con config.js
    # eventualmente personalizzato per lo scenario B).
    root /opt/seorrf/gui;
    index index.html;

    # SCENARIO A: l'API sulla stessa origine, dietro proxy.
    location /api/ {
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Server-Sent Events (/api/events e /api/v1/.../events):
        # niente buffering, connessione lunga.
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Gli asset vendorizzati non cambiano tra le release: cache
    # lunga ma revalidabile.
    location /vendor/ {
        add_header Cache-Control "public, max-age=86400";
    }
}
