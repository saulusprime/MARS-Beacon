# Pianificazione del monitoraggio citazioni IA: una volta a settimana.
#
# Installazione:
#   sudo cp deploy/mars-citations.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mars-citations.timer
#
# Verifica:  systemctl list-timers mars-citations
# Esecuzione manuale di prova:  sudo systemctl start mars-citations

[Unit]
Description=Monitoraggio citazioni IA settimanale

[Timer]
OnCalendar=Mon 07:30
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
